<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Configure <%= guild.name || guild.guild_id %></title>
  <style>
    body { font-family: system-ui, sans-serif; background: #1e1f22; color: #dbdee1; margin: 0; padding: 2rem; max-width: 720px; }
    h1 { color: #fff; }
    h3 { margin-top: 1.8rem; color: #fff; border-bottom: 1px solid #3f4147; padding-bottom: 0.4rem; }
    label { display: block; margin: 0.9rem 0 0.3rem; font-weight: 500; }
    input[type="checkbox"] { margin-right: 0.5rem; }
    input[type="text"], select, textarea {
      width: 100%; max-width: 420px; padding: 8px 12px; border-radius: 6px;
      border: 1px solid #3f4147; background: #1e1f22; color: #fff; font-size: 14px;
    }
    textarea { min-height: 60px; }
    .hint { font-size: 12px; color: #949ba4; margin-top: 2px; }
    button { background: #5865F2; color: white; border: none; padding: 10px 22px; border-radius: 6px; cursor: pointer; margin-top: 1.5rem; font-weight: 600; }
    button:hover { background: #4752c4; }
    .success { color: #57F287; margin-bottom: 1rem; }
    a { color: #00a8fc; }
    .row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .row > div { flex: 1; min-width: 200px; }
  </style>
</head>
<body>
  <a href="/dashboard">← Back</a>
  <h1><%= guild.name || 'Server' %></h1>
  <p>ID: <code><%= guild.guild_id %></code></p>

  <% if (typeof saved !== 'undefined' && saved) { %>
    <p class="success">✅ Settings saved!</p>
  <% } %>

  <form method="POST" action="/dashboard/<%= guild.guild_id %>/update">

    <h3>Features</h3>
    <label><input type="checkbox" name="modmail_enabled" <%= guild.modmail_enabled ? 'checked' : '' %>> Enable Modmail</label>
    <label><input type="checkbox" name="dm_before_mod" <%= guild.dm_before_mod ? 'checked' : '' %>> DM user before moderation actions</label>

    <h3>Plugins</h3>
    <label><input type="checkbox" name="moderation" <%= plugins.moderation !== false ? 'checked' : '' %>> Moderation</label>
    <label><input type="checkbox" name="reactionroles" <%= plugins.reactionroles !== false ? 'checked' : '' %>> Reaction Roles</label>
    <label><input type="checkbox" name="modmail" <%= plugins.modmail !== false ? 'checked' : '' %>> Modmail</label>
    <label><input type="checkbox" name="verification" <%= plugins.verification !== false ? 'checked' : '' %>> Verification</label>
    <label><input type="checkbox" name="automod" <%= plugins.automod === true ? 'checked' : '' %>> Automod</label>

    <h3>Roles</h3>
    <label>Verified Role ID</label>
    <input type="text" name="verified_role_id" value="<%= guild.verified_role_id || '' %>" placeholder="Role ID">
    <div class="hint">Right-click role → Copy Role ID</div>

    <label>Muted Role ID</label>
    <input type="text" name="muted_role_id" value="<%= guild.muted_role_id || '' %>" placeholder="Role ID">
    <div class="hint">Role given by /mute and automod mute action</div>

    <h3>Modmail</h3>
    <label>Modmail Category ID</label>
    <input type="text" name="modmail_category_id" value="<%= guild.modmail_category_id || '' %>" placeholder="Category ID">

    <h3>Automod</h3>
    <label><input type="checkbox" name="automod_enabled" <%= automod.enabled ? 'checked' : '' %>> Enable Automod</label>
    <label><input type="checkbox" name="automod_invites" <%= automod.invites !== false ? 'checked' : '' %>> Filter Discord invites</label>
    <label><input type="checkbox" name="automod_badwords" <%= automod.badwords !== false ? 'checked' : '' %>> Filter bad words</label>
    <label><input type="checkbox" name="automod_websites" <%= automod.websites ? 'checked' : '' %>> Filter websites / links</label>

    <label>Action when triggered</label>
    <select name="automod_action">
      <option value="clear" <%= automod.action === 'clear' ? 'selected' : '' %>>Just clear (delete message)</option>
      <option value="clear+mute" <%= automod.action === 'clear+mute' ? 'selected' : '' %>>Clear + Mute</option>
      <option value="clear+kick" <%= automod.action === 'clear+kick' ? 'selected' : '' %>>Clear + Kick</option>
      <option value="clear+soft" <%= automod.action === 'clear+soft' ? 'selected' : '' %>>Clear + Softban</option>
      <option value="clear+ban" <%= automod.action === 'clear+ban' ? 'selected' : '' %>>Clear + Ban</option>
    </select>

    <label>Bad words list (comma separated)</label>
    <textarea name="automod_badword_list" placeholder="word1,word2,word3"><%= automod.badword_list || '' %></textarea>

    <h3>Custom Emojis (optional)</h3>
    <div class="row">
      <div>
        <label>Success Emoji</label>
        <input type="text" name="emoji_success" value="<%= guild.emoji_success || '' %>" placeholder="✅">
      </div>
      <div>
        <label>Error Emoji</label>
        <input type="text" name="emoji_error" value="<%= guild.emoji_error || '' %>" placeholder="❌">
      </div>
    </div>

    <button type="submit">Save Changes</button>
  </form>
</body>
</html>
