<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Lumen</title>
  <style>
    :root {
      --bg: #0a0b0f;
      --card: #12141a;
      --border: rgba(255,255,255,0.07);
      --accent: #c9b896;
      --text: #e8e6e3;
      --muted: #8b8d97;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      min-height: 100vh;
      background-image: radial-gradient(ellipse 80% 50% at 50% -30%, rgba(201,184,150,0.08), transparent);
    }
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(8px);
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; }
    .brand .moon {
      width: 40px; height: 40px; border-radius: 50%;
      border: 1px solid rgba(201,184,150,0.35);
      overflow: hidden; background: #0a0b0f;
      display: flex; align-items: center; justify-content: center;
    }
    .brand .moon img { width: 100%; height: 100%; object-fit: cover; }
    .brand h1 { font-size: 1.15rem; margin: 0; font-weight: 600; }
    .nav a { color: var(--muted); text-decoration: none; margin-left: 1.25rem; font-size: 0.9rem; }
    .nav a:hover { color: var(--accent); }
    main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .intro { margin-bottom: 1.75rem; }
    .intro h2 { font-size: 1.5rem; margin: 0 0 0.35rem; }
    .intro p { color: var(--muted); margin: 0; }
    .grid { display: flex; flex-direction: column; gap: 0.75rem; }
    .guild {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.1rem 1.35rem;
      transition: border-color 0.15s, transform 0.15s;
      text-decoration: none;
      color: inherit;
    }
    .guild:hover {
      border-color: rgba(201,184,150,0.35);
      transform: translateY(-1px);
    }
    .guild-info strong { display: block; font-size: 1.05rem; }
    .guild-info span { color: var(--muted); font-size: 0.8rem; font-family: ui-monospace, monospace; }
    .arrow { color: var(--accent); font-size: 1.1rem; }
    .empty {
      text-align: center;
      padding: 3rem 1.5rem;
      background: var(--card);
      border: 1px dashed var(--border);
      border-radius: 14px;
      color: var(--muted);
    }
    .empty code { color: var(--accent); }
  </style>
</head>
<body>
  <header class="top">
    <div class="brand">
      <div class="moon">
        <img src="/logo.jpg" alt="" onerror="this.parentNode.textContent='🌙'">
      </div>
      <h1>Lumen</h1>
    </div>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/docs">Docs</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <div class="intro">
      <h2>Hello, <%= user.username %></h2>
      <p>Servers where you are owner or admin, and the bot is whitelisted.</p>
    </div>
    <% if (!guilds || guilds.length === 0) { %>
      <div class="empty">
        <p>No servers to manage yet.</p>
        <p style="margin-top:0.75rem;font-size:0.9rem">
          You need to be <strong>admin/owner</strong> on a server that is <strong>whitelisted</strong>
          (<code>/allow-server</code>).
        </p>
      </div>
    <% } else { %>
      <div class="grid">
        <% guilds.forEach(function(g) { %>
          <a class="guild" href="/dashboard/<%= g.guild_id %>">
            <div class="guild-info">
              <strong><%= g.name || 'Unknown server' %></strong>
              <span><%= g.guild_id %></span>
            </div>
            <span class="arrow">→</span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
