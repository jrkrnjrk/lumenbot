<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #1e1f22; color: #dbdee1; margin: 0; padding: 2rem; }
    h1 { color: #fff; }
    .guild { background: #2b2d31; padding: 1rem 1.5rem; margin: 0.5rem 0; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; }
    a { color: #00a8fc; text-decoration: none; }
    .logout { float: right; }
  </style>
</head>
<body>
  <a class="logout" href="/logout">Logout</a>
  <h1>Welcome, <%= user.username %></h1>
  <p>Select a waitlisted server to configure:</p>
  <% if (guilds.length === 0) { %>
    <p>No waitlisted servers yet. Use <code>/allow-server</code> in Discord.</p>
  <% } %>
  <% guilds.forEach(g => { %>
    <div class="guild">
      <span><strong><%= g.name || g.guild_id %></strong> <small>(<%= g.guild_id %>)</small></span>
      <a href="/dashboard/<%= g.guild_id %>">Configure →</a>
    </div>
  <% }) %>
</body>
</html>
