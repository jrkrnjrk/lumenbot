<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard — Lumen</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0a0b0f; color: #dbdee1; margin: 0; padding: 2rem; }
    header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    header img { width: 40px; height: 40px; border-radius: 50%; margin-right: 0.75rem; }
    .brand { display: flex; align-items: center; }
    h1 { font-size: 1.35rem; margin: 0; color: #fff; }
    a { color: #c9b896; text-decoration: none; }
    .guild {
      background: #12141a;
      border: 1px solid rgba(255,255,255,0.06);
      padding: 1rem 1.25rem;
      margin: 0.5rem 0;
      border-radius: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .guild:hover { border-color: rgba(201,184,150,0.3); }
    .empty { color: #8b8d97; margin-top: 1rem; }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <img src="/logo.jpg" alt="">
      <h1>Lumen — <%= user.username %></h1>
    </div>
    <div>
      <a href="/">Home</a> ·
      <a href="/docs">Docs</a> ·
      <a href="/logout">Logout</a>
    </div>
  </header>
  <p style="color:#8b8d97">Whitelisted servers</p>
  <% if (!guilds || guilds.length === 0) { %>
    <p class="empty">No whitelisted servers. Use <code>/allow-server</code> in Discord.</p>
  <% } %>
  <% (guilds || []).forEach(g => { %>
    <div class="guild">
      <span><strong><%= g.name || g.guild_id %></strong><br><small style="color:#8b8d97"><%= g.guild_id %></small></span>
      <a href="/dashboard/<%= g.guild_id %>">Configure →</a>
    </div>
  <% }) %>
</body>
</html>
