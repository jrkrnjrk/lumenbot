<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login — Lumen</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      background: #0a0b0f;
      color: #e8e6e3;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
    }
    .card {
      background: #12141a;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 2.5rem 3rem;
      text-align: center;
      max-width: 380px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    img {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      margin-bottom: 1rem;
      border: 2px solid rgba(201,184,150,0.35);
    }
    h1 { font-size: 1.75rem; margin: 0 0 0.35rem; }
    p { color: #8b8d97; margin: 0 0 1.75rem; }
    a.btn {
      display: inline-block;
      background: #5865F2;
      color: #fff;
      padding: 12px 28px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
    }
    a.btn:hover { background: #4752c4; }
    a.back { display: block; margin-top: 1.25rem; color: #8b8d97; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <img src="/logo.jpg" alt="Lumen">
    <h1>Lumen Dashboard</h1>
    <p>Sign in with Discord to manage your servers</p>
    <a class="btn" href="/auth/discord">Login with Discord</a>
    <a class="back" href="/">← Back to home</a>
  </div>
</body>
</html>
